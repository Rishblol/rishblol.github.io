---
import Container from '@/components/Container.astro'
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer class="py-4">
  <Container>
    <div class="flex items-center justify-between">
      <Link
        href="https://amrita.town/"
        class="text-foreground text-lg text-emerald-500 hover:text-primary"
        external
      >
        amrita.town
      </Link>

      <div class="flex items-center space-x-3">
        <Link href="https://amrita.town/prev" class="text-foreground" external>
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#10b981"><path d="M400-240 160-480l240-240 56 58-142 142h486v80H314l142 142-56 58Z"/></svg></Link>
        <Link href="https://amrita.town/random" class="text-foreground" external>
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#10b981"><path d="M160-160v-80h110l-16-14q-52-46-73-105t-21-119q0-111 66.5-197.5T400-790v84q-72 26-116 88.5T240-478q0 45 17 87.5t53 78.5l10 10v-98h80v240H160Zm400-10v-84q72-26 116-88.5T720-482q0-45-17-87.5T650-648l-10-10v98h-80v-240h240v80H690l16 14q49 49 71.5 106.5T800-482q0 111-66.5 197.5T560-170Z"/></svg>
        </Link>
        <Link href="https://amrita.town/next" class="text-foreground" external>
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#10b981"><path d="m560-240-56-58 142-142H160v-80h486L504-662l56-58 240 240-240 240Z"/></svg>
        </Link>
      </div>

      <div class="flex items-center">
        <SocialIcons links={SOCIAL_LINKS} />
      </div>
    </div>
  </Container>
</footer>

